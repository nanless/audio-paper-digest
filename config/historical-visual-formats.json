{
  "paperManifestVersion": 3,
  "coverManifestVersion": 1,
  "paperQaChecklist": "visual-semantic-v1",
  "coverQaChecklist": "digest-cover-semantic-v1",
  "readerSourceContract": "signed-reader-visual-source-v1",
  "ephemeralFigurePersistenceContract": "ephemeral-no-persisted-figure-assets-v1",
  "rendering": {
    "mode": "full_image_generation_v2",
    "renderer": "built-in image_gen",
    "resolutionPolicy": "highest_available_portrait",
    "orientation": "portrait",
    "preferredAspectRatio": "1:2",
    "minimumWidth": 768,
    "minimumHeight": 1024,
    "maxPngBytes": 8388608
  }
}
