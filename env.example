# Audio Research Workbench 环境变量配置示例
# 复制此文件为 .env 并填入你的真实值

# ==================== 抓取/筛选/分析必需配置 ====================

# Audio Research Workbench 分析配置（AI 分析论文用）
# 主模型（文本分析，必填）
PAPER_ANALYZER_API_KEY=your-api-key-here
# 可选：同一 OpenCode Go 模型的备用账号，逗号分隔。同一池内所有账号等权，
# 按账号 ID 稳定排序轮转（round-robin）；只有明确的 HTTP 429 GoUsageLimitError
# 或 HTTP 401 Insufficient balance 才切到下一个账号并记冷却，冷却到期自动回到轮转。
# 普通 401 会停止本次运行，普通 429/5xx/网络错误/输出截断不会换号。
# 不要把“副模型”变量当成备用账号；两个概念彼此独立。
# PAPER_ANALYZER_FALLBACK_API_KEYS=your-second-opencode-go-key
# PAPER_ANALYZER_TERTIARY_FALLBACK_API_KEY=your-third-opencode-go-key
# 上述尾部变量也支持逗号列表，例如 third-key,fourth-key，均排在普通 fallback 列表之后。
# 论文模型按项目配置指定（2026-11-16 起为 muse-spark-1.3-contributor + xhigh；2026-11-13 到 11-15 曾用 deepseek-v4.1-flash）；
# muse-spark-* 强制走项目 HTTP CONNECT 代理，基础 /v1 端点由公共封装转为 /v1/responses。
PAPER_ANALYZER_MODEL=muse-spark-1.3-contributor
PAPER_ANALYZER_ENDPOINT=https://opencode.ai/zen/go/v1

# 副模型（旧版插图计划，可选）
# API Reader（现行 structured-pipeline-v5）会把安全处理后的论文图直接交给主模型，因此主模型端点与所选协议需要支持图片输入。
# 主模型走 OpenAI Responses，图片按 Responses 格式发送。
# 不设置副模型时只跳过旧版插图补充；不会关闭 API Reader 的论文图图文解读。
# 设置后：副模型只筛选旧版候选图，并生成插图位置、图前导语和图后解释
# 副模型不得替换主模型原句；代码会忽略旧 replacement/rewrite 字段
# endpoint 未设置时复用主端点；key 仅在主副属于同一规范服务时才可复用，跨服务必须显式配置
# PAPER_ANALYZER_SECONDARY_MODEL=muse-spark-1.3-contributor
# PAPER_ANALYZER_SECONDARY_ENDPOINT=https://opencode.ai/zen/go/v1
# PAPER_ANALYZER_SECONDARY_API_KEY=your-secondary-key
# 副模型自己也使用多个 OpenCode Go 账号时单独配置；只有主/副端点属于同一规范 OpenCode Go 服务且
# 副模型未配置独立 key 时，才复用主账号池。不同服务必须显式提供副模型 key。
# PAPER_ANALYZER_SECONDARY_FALLBACK_API_KEYS=your-secondary-second-key

# ==================== 博客与发布配置 ====================

# Blog 发布配置（博客发布必需；全流程抓取时也用于博客已发布论文去重）
PAPER_DIGEST_BLOG_REPO=~/code/github_repos/audio-research-portal
# verify:web 使用：站点 posts 根地址与 Pages workflow 仓库（按实际站点替换）
PAPER_DIGEST_BLOG_URL=https://nanless.github.io/audio-research-portal/posts
# PAPER_DIGEST_BLOG_REPO_RUN=<owner>/<repo>
# 历史 ICLR 2026 本地 accepted metadata/PDF 根目录（只供全历史会议 direct 路线）。
# 目录必须是本机已保留的官方会议抓取数据；不设置时使用 ~/code/github_repos/iclr2026-paper-scraper。
# PAPER_DIGEST_ICLR_2026_ACCEPTED_ROOT=~/code/github_repos/iclr2026-paper-scraper
# 独立论文页三层 review 并发度（汇总页仍先串行审查）；日更/历史范围 1-32，会议发布器读取后夹取到最多 5 路
# PD_BLOG_REVIEW_CONCURRENCY=16
PAPER_DIGEST_BLOG_BASE_PATH=/audio-research-portal
PAPER_DIGEST_GITHUB_REMOTE=origin
# 会议图片仓库与图床地址（发布会议页面时使用）。
# 仓库默认取 ~/code/github_repos/audio-paper-digest-images；图床地址默认指向该仓库的 raw 路径。
# PAPER_DIGEST_IMAGE_REPO=~/code/github_repos/audio-paper-digest-images
# PAPER_DIGEST_IMAGE_BASE_URL=https://raw.githubusercontent.com/nanless/audio-paper-digest-images/main

# ==================== 可选配置 ====================

# 整篇分析并发默认 3；`muse-spark-*` 不会被串行化，每个请求各自创建并销毁 HTTP CONNECT agent；
# 兼容的 `mimo-v2.6-flash` 不含该前缀，走直连，不建代理连接
# PD_ANALYSIS_CONCURRENCY=3
# 整批分析轮数（兼容旧写法）：PD_ANALYSIS_MAX_RETRIES=2 等价于 3 轮，范围 0-9
# PD_ANALYSIS_MAX_RETRIES=2
# 等价的显式写法，优先于上一项，范围 1-10
# PD_ANALYSIS_BATCH_MAX_ROUNDS=3
# 人工交接建议的失败集合上限（0 关闭，范围 0-5）与最低轮数/无进展轮数（范围 3-10）
# PD_ANALYSIS_MANUAL_HANDOFF_MAX_ITEMS=5
# PD_ANALYSIS_MANUAL_HANDOFF_MIN_ROUNDS=3
# PD_ANALYSIS_MANUAL_HANDOFF_NO_PROGRESS_ROUNDS=3
# 入选论文的官方 PDF 在全部候选地址都返回 404 时，本批最多跳过的篇数（0-5，默认 2）。
# 超过上限、超时、认证错误、5xx 或解析失败仍停止整批；跳过的论文不进入分析、不生成页面，
# digest:status 会单列封存阶段已跳过的篇数（筛选阶段的 404 跳过不设上限，另记在 filter-decisions.json）。
# PD_DAILY_SOURCE_SKIP_MAX=2
# 用户明确授权的日更人工修正名额（1-15）。默认按原封存入选集篇数计算
# min(15, max(10, floor(N/10)))，N<110 时固定 10 篇；本变量只允许抬高、不能降低默认值。
# PD_DAILY_CORRECTION_LIMIT=15
# 单次分析内部每个 LLM API 阶段的最大尝试次数（区别于整篇 PD_ANALYSIS_MAX_RETRIES）
# PD_ANALYSIS_API_MAX_RETRIES=3
# 主分析输出预算；默认 192000
# PD_ANALYSIS_API_MAX_TOKENS=192000
# 单次 LLM HTTP 响应总字节硬上限；默认 16 MiB，超限整段失败且不解析截断内容
# PD_ANALYSIS_API_MAX_RESPONSE_BYTES=16777216
# 下面两项只作用于 OpenAI Responses 协议（`muse-spark-*` 或显式 /responses 端点）；
# 当前 Muse 使用 Responses；兼容的 `mimo-v2.6-flash` 走 Chat Completions，这两项对它没有作用
#（深度执行的审计记录仍会读到它们的值，只是不进请求体）。
# Responses 推理强度按模型分表：muse-spark-* 是 minimal / low / medium / high / xhigh（max、highest、maximum 视作 xhigh）；
# deepseek-v4.1-flash 是 low / high / max（写 xhigh 会被网关静默丢弃，所以配置检查会拦）。
# 不设置时不发送 reasoning 字段。推理 token 与可见输出共用 max_output_tokens，对应各阶段输出预算见 AGENTS.md。
# PD_OPENAI_RESPONSES_REASONING_EFFORT=xhigh
# 默认开启（1）按阶段分级推理强度：核心主分析与 Reader 长文保持配置上限，审校/局部修复为 high，
# 轻量机械阶段下调至 minimal/low；设为 0 恢复全阶段统一档位。
# PD_TIERED_REASONING_EFFORT=1
# 默认开启（1）按阶段注入稳定 prompt_cache_key 提升前缀缓存命中；设为 0 可关闭。
# PD_OPENAI_RESPONSES_PROMPT_CACHE_KEY=1
# 可选：为 OpenAI Responses 请求启用 SSE（Node 与 Python 发布审查均支持）；未设置时使用普通 JSON 响应
# PD_OPENAI_RESPONSES_STREAM=1
# 可选：固定发送给 OpenCode Go 的会话标识；不设置时每个进程生成一个稳定随机值。
# PD_OPENCODE_SESSION_ID=audio-paper-digest-local
# 完整13章正文审校重写输出上限；截断响应仍拒绝
# PD_ANALYSIS_REVISION_MAX_TOKENS=192000
# 完整13章结构重写输出上限
# PD_ANALYSIS_STRUCTURE_MAX_TOKENS=192000
# 核心摘要修补输出容量；摘要本身仍须满足原长度与内容要求
# PD_ANALYSIS_CORE_SUMMARY_REPAIR_MAX_TOKENS=32000
# 表格/方法等局部修复输出上限
# PD_ANALYSIS_REPAIR_MAX_TOKENS=96000
# 初学研究者长文独立输出上限，不受局部修复上限挤压
# PD_API_READER_MAX_TOKENS=128000
# 仅 MiMo-V2.6-Flash 的长文、长文修复及图像探测请求；Go 实际支持须由运行响应核验
# PD_API_READER_THINKING_MODE=disabled
# 仅控制摘要、完整结构和表格修复；主分析和审校不变
# PD_ANALYSIS_REPAIR_THINKING_MODE=disabled
# 主分析推理开关，默认关闭；仅精确 mimo-v2.6-flash 的 OpenAI Chat 主分析生效
# PD_ANALYSIS_PRIMARY_THINKING_MODE=disabled
# 开源检查、正文审校、评分和标签处理的推理开关；仅同一 MiMo Chat 路由生效
# PD_ANALYSIS_AUXILIARY_THINKING_MODE=disabled
# 局部块补丁的输出预算；基础值取 min(正文预算, 本配置)，默认 96000，完整生成仍使用上面的预算。
# PD_API_READER_REPAIR_MAX_TOKENS=96000
# API Reader 请求的活跃时间上限（毫秒），系统睡眠时间不计入
# PD_API_READER_OVERALL_TIMEOUT_MS=2400000
# 单进程 API reader 重阶段并发上限（最高 60，默认 5）
# PD_API_READER_CONCURRENCY=5
# 积压批次可显式增至 60；逐篇预算不变，观察实际超时与限流后调整。
# 分阶段输入证据预算（字符数）：默认主分析 200000；后处理只发送任务相关切片
# PD_ANALYSIS_FULL_TEXT_MAX_CHARS=200000
# PD_OPENSOURCE_EVIDENCE_MAX_CHARS=16000
# PD_REVISION_EVIDENCE_MAX_CHARS=60000
# PD_API_READER_EVIDENCE_MAX_CHARS=180000
# 长文完整渲染后的请求上下文硬上限（含 prompt、canonical 分析与证据）
# PD_API_READER_CONTEXT_MAX_CHARS=240000
# PD_SCORING_EVIDENCE_MAX_CHARS=40000
# PD_REPAIR_EVIDENCE_MAX_CHARS=30000
# PD_STRUCTURE_EVIDENCE_MAX_CHARS=40000
# PD_REANALYZE_CONCURRENCY=3
# 会议发布后线上验收并发，默认 4，范围 1-16
# PD_CONFERENCE_ONLINE_VERIFY_CONCURRENCY=4
# 历史 Python 审查的页面并发，默认 5，范围 1-16
# PD_HISTORY_REVIEW_CONCURRENCY=5
# LLM 筛选批次默认 5；主模型和其他模型都使用这里的值，账号状态转换另有短锁保护
# PD_FILTER_BATCH_SIZE=5
# LLM 前默认启用高召回关键词预筛；设为 0 可临时让全部候选直接进入 LLM
# PD_KEYWORD_PREFILTER_ENABLED=1
# arXiv 每类抓取数量与源站并发闸门上限（默认 3，范围 1-6，共享 Retry-After 退避）
# PD_ARXIV_MAX_RESULTS=100
# PD_ARXIV_MAX_CONCURRENCY=3
# arXiv 元数据抓取最多尝试次数、普通错误/429 退避基数与单类总等待预算
# PD_ARXIV_FETCH_MAX_RETRIES=5
# PD_ARXIV_FETCH_RETRY_BASE_DELAY_MS=5000
# PD_ARXIV_RATE_LIMIT_BASE_DELAY_MS=60000
# PD_ARXIV_FETCH_MAX_WAIT_MS=600000
# arXiv host scheduler 的健康/瞬时失败/429 冷却；只在下一次同 host 请求前支付
# PD_ARXIV_HEALTHY_COOLDOWN_MS=1000
# PD_ARXIV_TRANSIENT_COOLDOWN_MS=5000
# PD_ARXIV_RATE_LIMIT_COOLDOWN_MS=60000
# PD_ARXIV_COOLDOWN_JITTER_MS=1000
# arXiv recent/search/abs/Atom 元数据请求绝对截止时间与响应字节上限
# PD_ARXIV_METADATA_TIMEOUT_MS=60000
# PD_ARXIV_METADATA_MAX_BYTES=8388608
# 可选固定 User-Agent；未设置时使用 config.js 内置轮换池
# PD_ARXIV_USER_AGENT=paper-digest/1.0
# 深度分析单张图片原始字节上限
# PD_IMAGE_MAX_BYTES=6291456
# 副模型每篇默认最多实际插入 4 张高价值图片；可用正整数覆写
# PD_IMAGE_INSERTION_MAX=4
# 单张图片 base64 字符上限
# PD_IMAGE_MAX_BASE64_CHARS=8388608
# 单篇论文所有图片 base64 总上限
# PD_IMAGE_TOTAL_BASE64_CHARS=20971520
# arXiv 图床较慢时可调整单张图片下载超时（毫秒，默认 60000）
# PD_IMAGE_DOWNLOAD_TIMEOUT_MS=60000
# arXiv HTML/图片发现与 PDF 全文下载超时（毫秒）
# PD_ARXIV_FETCH_TIMEOUT_MS=60000
# PD_ARXIV_PDF_TIMEOUT_MS=180000
# PD_ARXIV_PDF_MAX_BYTES=52428800
# 单类 arXiv 遇到 HTTP 429 时的累计退避上限（毫秒，默认 120000）
# PD_ARXIV_RATE_LIMIT_MAX_WAIT_MS=120000
# 最终评分审计和副模型插图计划使用独立低温，降低重跑漂移
# PD_SCORING_AUDIT_TEMPERATURE=0.1
# PD_IMAGE_PLAN_TEMPERATURE=0.2
# 博客文本 review 默认每 20000 字一块，范围 4000-24000；增大可减少重复 prompt 并提升缓存复用
# PD_BLOG_REVIEW_CHUNK_CHARS=20000
# 单次博客 LLM review 输出预算，范围 1000-32000；默认 4000，隐藏推理耗尽时只做一次纯 JSON 有界恢复（默认最高 8000）
# PD_BLOG_REVIEW_MAX_TOKENS=4000
# 单页审查读超时（秒），默认 120，范围 30-600；只影响等待，不进审查协议指纹
# PD_BLOG_REVIEW_TIMEOUT=120
# 外部图片审查和 Hugo/Git 子进程都有绝对截止时间；超时会失败关闭或保留可续跑状态
# PD_BLOG_IMAGE_REVIEW_DEADLINE_SECONDS=120
# PD_HUGO_GATE_TIMEOUT_SECONDS=300
# PD_GIT_LOCAL_TIMEOUT_SECONDS=30
# PD_GIT_COMMIT_TIMEOUT_SECONDS=180
# PD_GIT_NETWORK_TIMEOUT_SECONDS=180

# 工作区角色开关，默认关闭。不开时 daily 工作区不能执行 history:* 命令，history 工作区也不能执行 daily 命令。
# 设为 1 后，本机 daily 工作区可以执行 history:* 命令，脚本会打印跨角色提示；反向仍然拒绝。
# 当前工作区统一运行日更、会议与历史任务；旧历史工作区已废弃。
# 开关不允许各类任务同时生成、审查或推送同一博客，执行任务的 Agent 负责错峰。
# PD_WORKSPACE_ALLOW_CROSS_ROLE=1

# 项目级代理是抓取必需配置，只读取本 `.env`，不继承 shell/IDE 代理，也不回退 macOS 系统代理。
# arXiv Node 请求和 `muse-spark-*` 模型必须使用 HTTP CONNECT；
# HTTPS_PROXY 或 HTTP_PROXY 至少配置一项 http(s):// 地址，缺失时立即失败，禁止静默直连。
# HuggingFace curl 继承 HTTP(S) 代理；代理同时提供 SOCKS 时可额外配置 ALL_PROXY。
# 其他 LLM 模型默认使用 agent:false 直连，不会自动复用这些代理变量；
# 兼容的 `mimo-v2.6-flash` 属于这一类；当前 Muse 不走直连。
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# ALL_PROXY=socks5h://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1

# 文件日志默认开启，输出 UTF-8 纯文本到 logs/；默认保留 30 天且总量不超过 256 MiB
# PD_LOG_RETENTION_DAYS=30
# PD_LOG_MAX_TOTAL_BYTES=268435456
# 运行存储清理仅考虑早于该天数且未被权威 JSON 引用的受控缓存（默认 30 天）
# PD_STORAGE_RETENTION_DAYS=30
# 设为 1 按北京时间 YYYY-MM-DD/ 子目录分片写入新 LLM 用量事件（默认 0 保持平铺兼容全量历史回放）
# PD_LLM_USAGE_SHARD_BY_DATE=0
# 兼容旧变量：PAPER_DIGEST_ENABLE_FILE_LOGS=1 或 PD_ENABLE_FILE_LOGS=1
# PAPER_DIGEST_ENABLE_FILE_LOGS=1
# PD_ENABLE_FILE_LOGS=1
# 仅在明确不需要文件日志时取消下一行注释
# PAPER_DIGEST_DISABLE_FILE_LOGS=1
# PD_DISABLE_FILE_LOGS=1

# ==================== 播客生成与发布（可选 CLI：npm run podcast:generate） ====================
# 播客默认按需手动运行，不接入日更自动主链。支持本地 IndexTTS2 Python 合成或远端 HTTP 端点。
# PD_PODCAST_GITHUB_REPO=nanless/audio-research-portal
# PD_PODCAST_RELEASE_TAG_PREFIX=podcast
# PD_PODCAST_RELEASE_TAG_GROUPING=monthly
# PD_INDEXTTS_MODEL_DIR=~/models/IndexTTS-2
# PD_INDEXTTS_CFG_PATH=~/models/IndexTTS-2/config.yaml
# PD_INDEXTTS_VOICE_PROMPT=~/voices/host.wav
# PD_INDEXTTS_COHOST_VOICE_PROMPT=~/voices/cohost.wav
# PD_INDEXTTS_ENDPOINT=https://your-indextts-host.example.com/v1/audio/speech
# PD_INDEXTTS_API_KEY=your-indextts-api-key
# PD_INDEXTTS_MODEL=indextts2
# PD_INDEXTTS_ALLOW_LOCAL_ENDPOINT=0
