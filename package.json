{
  "name": "audio-paper-digest",
  "version": "1.0.0",
  "description": "论文速递全流程自动化 - 从 arXiv + HuggingFace 抓取、LLM 筛选、多模态深度分析到生成博客与微信公众号草稿",
  "main": "scripts/full-fetch.js",
  "scripts": {
    "fetch": "node scripts/full-fetch.js",
    "test": "node --test tests/*.test.js",
    "deep": "node scripts/deep-analysis-only.js",
    "reanalyze": "node scripts/reanalyze.js",
    "batch": "node scripts/batch-analyze.js",
    "icassp": "node scripts/icassp-batch-analyze.js",
    "icassp-cat": "node scripts/icassp-categorize.js",
    "backfill": "python3 scripts/backfill_papers.py",
    "publish": "python3 scripts/publish-to-blog.py",
    "wechat": "python3 scripts/publish-wechat-full.py",
    "xiaohongshu": "python3 scripts/publish-xiaohongshu.py"
  },
  "keywords": [
    "arxiv",
    "paper",
    "digest",
    "multimodal",
    "huggingface",
    "wechat"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<your-username>/audio-paper-digest.git"
  },
  "bugs": {
    "url": "https://github.com/<your-username>/audio-paper-digest/issues"
  },
  "homepage": "https://github.com/<your-username>/audio-paper-digest#readme",
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
