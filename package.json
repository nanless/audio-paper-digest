{
  "name": "audio-paper-digest",
  "version": "1.0.0",
  "description": "论文速递全流程自动化 - 抓取、筛选、深度分析、博客审查发布及发布后视觉摘要",
  "main": "scripts/full-fetch.js",
  "scripts": {
    "digest:prepare": "PD_DAILY_API_MODE=1 bash run-daily-digest.sh",
    "digest:api": "PD_DAILY_API_MODE=1 bash run-daily-digest.sh",
    "digest:manual": "PD_DAILY_API_MODE=0 bash run-daily-digest.sh",
    "fetch": "node scripts/full-fetch.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js manual/tests/*.test.js",
    "test:default": "node --test --test-concurrency=1 tests/*.test.js",
    "test:manual": "node --test --test-concurrency=1 manual/tests/*.test.js",
    "verify": "node scripts/verify-project.js",
    "usage:report": "node scripts/llm-usage-report.js",
    "rewrite:source": "node scripts/rewrite-from-source.js",
    "paper:rethink": "node scripts/paper-rethink-server.js",
    "deep": "node scripts/deep-analysis-only.js",
    "api:reader:refresh": "node scripts/refresh-api-reader.js",
    "reanalyze": "node scripts/reanalyze.js",
    "batch": "node scripts/batch-analyze.js",
    "validate:data": "node scripts/validate-data-files.js",
    "keyword:recall": "node scripts/evaluate-keyword-prefilter.js",
    "digest:status": "node scripts/digest-run-report.js",
    "storage:status": "node scripts/runtime-storage.js status",
    "storage:prune": "node scripts/runtime-storage.js prune",
    "digest:waive-visuals": "node scripts/waive-post-publish-visuals.js",
    "visual:post-publish": "bash scripts/python-runtime.sh scripts/plan-post-publish-visuals.py",
    "visual:render:debug": "bash scripts/python-runtime.sh scripts/render-visual-summary.py",
    "visual:prepare": "node scripts/visual-summary-state.js prepare",
    "visual:status": "node scripts/visual-summary-state.js status",
    "visual:archive": "node scripts/visual-summary-state.js archive-legacy",
    "visual:record": "node scripts/visual-summary-state.js record",
    "visual:fail": "node scripts/visual-summary-state.js fail",
    "cover:status": "node scripts/digest-cover-state.js status",
    "cover:archive": "node scripts/digest-cover-state.js archive-legacy",
    "cover:record": "node scripts/digest-cover-state.js record",
    "cover:fail": "node scripts/digest-cover-state.js fail",
    "backfill": "python3 scripts/backfill_papers.py",
    "blog:generate": "bash scripts/python-runtime.sh scripts/generate-blog.py",
    "blog:activate-fresh": "node scripts/activate-fresh-publication.js",
    "blog:review": "bash scripts/python-runtime.sh scripts/review-blog.py",
    "blog:manual-review": "python3 manual/scripts/manual-review-blog.py",
    "blog:manual-attest": "python3 manual/scripts/assemble-manual-review-attestation.py",
    "blog:manual-plan": "python3 manual/scripts/assemble-manual-review-attestation.py --plan",
    "manual:fetch": "node manual/scripts/manual-fetch.js",
    "manual:filter-merge": "node manual/scripts/merge-manual-filter-spec.js",
    "manual:fulltext": "node manual/scripts/manual-fetch-fulltext.js",
    "manual:packet": "node manual/scripts/manual-v6-production-packet.js",
    "manual:records": "node manual/scripts/manual-v6-production-records.js",
    "manual:correction": "node manual/scripts/manual-v6-metadata-correction.js",
    "manual:bind-revision": "node manual/scripts/manual-v6-revision-binder.js",
    "manual:spec": "node manual/scripts/create-manual-analysis-spec-v6.js --production",
    "manual:analyze": "node manual/scripts/manual-deep-analysis.js --v6-production",
    "manual:tasks": "node manual/scripts/manual-v6-task-runner.js",
    "manual:work-queue": "node manual/scripts/manual-v6-task-runner.js status",
    "manual:performance-report": "node manual/scripts/manual-performance-report.js",
    "manual:v5:spec": "node manual/scripts/create-manual-analysis-spec.js",
    "manual:v5:analyze": "node manual/scripts/manual-deep-analysis.js",
    "manual:v5:author-packet": "node manual/scripts/manual-v5-author-packet.js",
    "manual:v5:promote-draft": "node manual/scripts/manual-v5-promote-draft.js",
    "manual:v5:work-queue": "node manual/scripts/manual-v5-work-queue.js",
    "manual:v6:spec": "node manual/scripts/create-manual-analysis-spec-v6.js --production",
    "manual:v6:analyze": "node manual/scripts/manual-deep-analysis.js --v6-production",
    "manual:v6:packet": "node manual/scripts/manual-v6-production-packet.js",
    "manual:v6:records": "node manual/scripts/manual-v6-production-records.js",
    "manual:v6:bind-revision": "node manual/scripts/manual-v6-revision-binder.js",
    "manual:v6:shadow:spec": "node manual/scripts/create-manual-analysis-spec-v6.js --shadow",
    "manual:v6:shadow:analyze": "node manual/scripts/manual-deep-analysis.js --v6-shadow",
    "manual:v6:tasks": "node manual/scripts/manual-v6-task-runner.js",
    "manual:shadow": "node manual/scripts/manual-v6-shadow.js",
    "manual:shadow:benchmark": "node manual/scripts/manual-shadow-benchmark.js",
    "blog:push": "bash scripts/python-runtime.sh scripts/push-blog.py",
    "wechat": "python3 scripts/publish-wechat-full.py",
    "xiaohongshu": "python3 scripts/publish-xiaohongshu.py",
    "xhs-login": "python3 scripts/xiaohongshu-publisher.py --login",
    "xhs-publish": "python3 scripts/xiaohongshu-publisher.py",
    "xhs-publish-all": "python3 scripts/xiaohongshu-publisher.py --all"
  },
  "keywords": [
    "arxiv",
    "paper",
    "digest",
    "multimodal",
    "huggingface",
    "wechat"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanless/audio-paper-digest.git"
  },
  "bugs": {
    "url": "https://github.com/nanless/audio-paper-digest/issues"
  },
  "homepage": "https://github.com/nanless/audio-paper-digest#readme",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "cheerio": "^1.2.0",
    "pdf-parse": "^2.4.5"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "engines": {
    "node": ">=20.18.1 <21 || >=22.3.0"
  }
}
