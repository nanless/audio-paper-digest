{
  "name": "audio-paper-digest",
  "version": "1.0.0",
  "description": "论文速递全流程自动化 - 抓取、筛选、深度分析、博客审查发布及发布后视觉摘要",
  "main": "scripts/full-fetch.js",
  "scripts": {
    "digest:prepare": "bash run-daily-digest.sh",
    "fetch": "node scripts/full-fetch.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "deep": "node scripts/deep-analysis-only.js",
    "reanalyze": "node scripts/reanalyze.js",
    "batch": "node scripts/batch-analyze.js",
    "validate:data": "node scripts/validate-data-files.js",
    "keyword:recall": "node scripts/evaluate-keyword-prefilter.js",
    "digest:status": "node scripts/digest-run-report.js",
    "visual:post-publish": "python3 scripts/plan-post-publish-visuals.py",
    "visual:render:debug": "python3 scripts/render-visual-summary.py",
    "visual:prepare": "node scripts/visual-summary-state.js prepare",
    "visual:status": "node scripts/visual-summary-state.js status",
    "visual:archive": "node scripts/visual-summary-state.js archive-legacy",
    "visual:record": "node scripts/visual-summary-state.js record",
    "visual:fail": "node scripts/visual-summary-state.js fail",
    "cover:status": "node scripts/digest-cover-state.js status",
    "cover:archive": "node scripts/digest-cover-state.js archive-legacy",
    "cover:record": "node scripts/digest-cover-state.js record",
    "cover:fail": "node scripts/digest-cover-state.js fail",
    "backfill": "python3 scripts/backfill_papers.py",
    "blog:generate": "python3 scripts/generate-blog.py",
    "blog:review": "python3 scripts/review-blog.py",
    "blog:manual-review": "python3 scripts/manual-review-blog.py",
    "manual:fetch": "node scripts/manual-fetch.js",
    "manual:fulltext": "node scripts/manual-fetch-fulltext.js",
    "manual:spec": "node scripts/create-manual-analysis-spec.js",
    "manual:analyze": "node scripts/manual-deep-analysis.js",
    "blog:push": "python3 scripts/push-blog.py",
    "wechat": "python3 scripts/publish-wechat-full.py",
    "xiaohongshu": "python3 scripts/publish-xiaohongshu.py",
    "xhs-login": "python3 scripts/xiaohongshu-publisher.py --login",
    "xhs-publish": "python3 scripts/xiaohongshu-publisher.py",
    "xhs-publish-all": "python3 scripts/xiaohongshu-publisher.py --all"
  },
  "keywords": [
    "arxiv",
    "paper",
    "digest",
    "multimodal",
    "huggingface",
    "wechat"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanless/audio-paper-digest.git"
  },
  "bugs": {
    "url": "https://github.com/nanless/audio-paper-digest/issues"
  },
  "homepage": "https://github.com/nanless/audio-paper-digest#readme",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "cheerio": "^1.2.0",
    "pdf-parse": "^2.4.5"
  },
  "engines": {
    "node": ">=20.18.1 <21 || >=22.3.0"
  }
}
