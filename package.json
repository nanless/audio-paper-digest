{
  "name": "audio-paper-digest",
  "version": "1.0.0",
  "description": "论文速递全流程自动化 - 从 arXiv + HuggingFace 抓取、LLM 筛选、多模态深度分析到生成博客与微信公众号草稿",
  "main": "scripts/full-fetch.js",
  "scripts": {
    "fetch": "node scripts/full-fetch.js",
    "test": "node --test tests/*.test.js",
    "deep": "node scripts/deep-analysis-only.js",
    "reanalyze": "node scripts/reanalyze.js",
    "batch": "node scripts/batch-analyze.js",
    "backfill": "python3 scripts/backfill_papers.py",
    "publish": "python3 scripts/publish-to-blog.py",
    "wechat": "python3 scripts/publish-wechat-full.py",
    "xiaohongshu": "python3 scripts/publish-xiaohongshu.py",
    "xhs-login": "python3 scripts/xiaohongshu-publisher.py --login",
    "xhs-publish": "python3 scripts/xiaohongshu-publisher.py",
    "xhs-publish-all": "python3 scripts/xiaohongshu-publisher.py --all",
    "icml-fetch": "python3 scripts/fetch-icml2026.py",
    "icml-filter": "node scripts/icml-filter.js",
    "icml-analyze": "node scripts/icml-batch-analyze.js",
    "icml-retry": "node scripts/icml-retry-failed.js",
    "icml-reanalyze-pdf": "node scripts/icml-reanalyze-pdf.js",
    "icml-download-pdfs": "python3 scripts/download-icml-pdfs.py",
    "icml-fetch-openreview": "python3 scripts/fetch-icml2026-openreview.py"
  },
  "keywords": [
    "arxiv",
    "paper",
    "digest",
    "multimodal",
    "huggingface",
    "wechat"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanless/audio-paper-digest.git"
  },
  "bugs": {
    "url": "https://github.com/nanless/audio-paper-digest/issues"
  },
  "homepage": "https://github.com/nanless/audio-paper-digest#readme",
  "dependencies": {
    "cheerio": "^1.2.0",
    "pdf-parse": "^2.4.5",
    "puppeteer-core": "^25.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
